---
import { Picture } from "astro:assets";
import { LuArrowRight, LuLock, LuScale, LuPlug } from "react-icons/lu";
import wallLight from "@assets/landing/wallpaper-light.webp";
import wallDark from "@assets/landing/wallpaper-dark.webp";
import frostLight from "@assets/landing/wallpaper-light-blur.webp";
import frostDark from "@assets/landing/wallpaper-dark-blur.webp";
import HeroDemo from "./hero/HeroDemo.astro";
import { INVITE_URL } from "./links";

// Buzlu camın arkasında kalan fotoğraf için yüksek kalite ve çözünürlük gerekmiyor.
const wallProps = {
  formats: ["avif"] as const,
  fallbackFormat: "webp" as const,
  widths: [960, 1440],
  sizes: "100vw",
  quality: 50,
};
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <!-- App'teki gibi duvar kâğıdı; başlığın arkasında buzlu cam. -->
  <div class="backdrop" aria-hidden="true">
    <Picture class="wall wall--light" src={wallLight} alt="" loading="lazy" {...wallProps} />
    <Picture class="wall wall--dark" src={wallDark} alt="" loading="lazy" {...wallProps} />
    <img class="wall frost wall--light" src={frostLight.src} alt="" />
    <img class="wall frost wall--dark" src={frostDark.src} alt="" />
  </div>

  <div class="copy page-width">
    <p class="eyebrow glass">
      <span class="pulse-dot"></span>
      Davetli beta<span class="eyebrow__more"> · Avukatlar ve hukuk büroları için</span>
    </p>
    <h1 id="hero-title">
      <span class="h1__lead" style="--i:0">Yeni ekip arkadaşınız</span>
      <span class="h1__name" style="--i:1"><span class="mark">Armağan</span></span>
    </h1>
    <p class="lead">
      Yapay zekâyla çalışır: takip, hesap, düzen ve hatırlatma onda; karar ve imza her zaman
      sizde.
    </p>
    <div class="ctas">
      <a class="btn btn--primary" href={INVITE_URL}>Davet isteyin <LuArrowRight /></a>
      <a class="btn btn--glass" href="#ozellikler">Armağan'la tanışın</a>
    </div>
    <ul class="trust">
      <li><LuLock /> Evraklar uçtan uca şifreli</li>
      <li><LuScale /> KVKK'ya uygun saklama</li>
      <li><LuPlug /> UYAP ve UETS'le çalışır</li>
    </ul>
  </div>

  <div class="demo page-width">
    <HeroDemo />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -84px;
    padding: 136px 0 clamp(72px, 10vw, 140px);
    overflow: clip;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .backdrop :global(.wall) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .backdrop :global(.wall--dark),
  :global(.dark) .backdrop :global(.wall--light) {
    display: none;
  }
  :global(.dark) .backdrop :global(.wall--dark) {
    display: block;
  }
  .frost {
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 36%, transparent 60%);
    mask-image: linear-gradient(180deg, #000 0%, #000 36%, transparent 60%);
  }
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg) 70%, transparent) 0%,
      color-mix(in srgb, var(--bg) 42%, transparent) 38%,
      transparent 58%,
      transparent 78%,
      var(--bg) 100%
    );
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eyebrow {
    margin-bottom: 28px;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  h1 {
    font-size: clamp(46px, 7vw, 100px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  h1 > span {
    display: block;
  }
  /* İsim tanıtımı: kısa bir giriş satırı, altında büyük "Armağan" */
  .h1__lead {
    font-size: 0.58em;
    letter-spacing: -0.02em;
  }
  .h1__name {
    font-size: 1.5em;
    line-height: 0.98;
  }
  /* "Armağan'da": logodaki dört renk, altında çizilerek beliren bir şerit */
  .mark {
    position: relative;
    white-space: nowrap;
  }
  .mark::after {
    content: "";
    position: absolute;
    left: 0.03em;
    right: 0.03em;
    bottom: -0.05em;
    height: 0.07em;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--c-green) 0 25%,
      var(--c-red) 25% 50%,
      var(--c-purple) 50% 75%,
      var(--c-yellow) 75% 100%
    );
    transform-origin: left;
  }
  .lead {
    max-width: 640px;
    margin-top: clamp(34px, 4vw, 54px);
    text-wrap: balance;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.45vw, 19.5px);
    line-height: 1.55;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin-top: 28px;
    color: var(--ink-soft);
    font-size: 14px;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .trust :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--c-green-ink);
  }
  .demo {
    max-width: 1100px;
    margin-top: clamp(92px, 11vw, 150px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .eyebrow,
    h1 > span,
    .lead,
    .ctas,
    .trust,
    .demo {
      animation: rise 0.9s var(--ease-out) both;
    }
    h1 > span {
      animation-delay: calc(80ms + var(--i) * 90ms);
    }
    .mark::after {
      animation: draw 0.9s var(--ease-out) 0.75s both;
    }
    .lead {
      animation-delay: 380ms;
    }
    .ctas {
      animation-delay: 460ms;
    }
    .trust {
      animation-delay: 540ms;
    }
    .demo {
      animation-delay: 620ms;
      animation-duration: 1.2s;
    }
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 120px;
    }
    .eyebrow__more {
      display: none;
    }
    .trust {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .ctas {
      width: 100%;
    }
    .ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
