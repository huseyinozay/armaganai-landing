---
import type { MascotColor } from "../mascot/family";

interface Props {
  /** Bölümdeki sırası ("01"); üst etiketteki numara bu renkte. */
  n: string;
  color: MascotColor;
  eyebrow: string;
  title: string;
  text: string;
  headingId: string;
  class?: string;
}

const { n, color, eyebrow, title, text, headingId, class: className } = Astro.props;
---

<article class:list={["panel", className]} aria-labelledby={headingId}>
  <header class="panel__head">
    <p class="panel__eyebrow"><span style={`--dot:var(--c-${color})`}>{n}</span>{eyebrow}</p>
    <h3 id={headingId}>{title}</h3>
    <p class="panel__text">{text}</p>
  </header>
  <slot />
</article>

<style>
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3.4vw, 44px);
    padding: clamp(24px, 3.6vw, 44px);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.045), rgb(255 255 255 / 0.015));
  }
  .panel__head {
    display: grid;
    gap: 12px;
    max-width: 640px;
  }
  .panel__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-soft);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .panel__eyebrow span {
    padding: 4px 7px;
    border: 1px solid color-mix(in srgb, var(--dot) 55%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--dot) 12%, transparent);
    color: var(--dot);
  }
  h3 {
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 650;
    letter-spacing: -0.022em;
    line-height: 1.12;
  }
  .panel__text {
    color: var(--ink-soft);
    font-size: clamp(15px, 1.15vw, 16.5px);
    line-height: 1.6;
  }
</style>
