---
import { LuBrainCircuit, LuTrash2 } from "react-icons/lu";
import Panel from "./Panel.astro";

// Kadrandaki 24 çentik, her 6 saatte bir uzun.
const hours = Array.from({ length: 24 }, (_, hour) => hour);
---

<Panel
  n="02"
  color="yellow"
  eyebrow="Yapay zekâ"
  headingId="yapay-zeka-title"
  title="Yapay zekâ verileriniz en geç 24 saat içinde silinir, eğitimde kullanılmaz."
  text="Tarafımızca yapılan sözleşmelerle yapay zekâ verilerinizin 24 saat içinde silinmesi ve eğitimde kullanılmaması garanti altına alınmıştır."
>
  <div class="promises" data-play data-reveal>
    <div class="promise">
      <div class="picto picto--train" aria-hidden="true">
        <LuBrainCircuit />
        <svg class="ban" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="44" pathLength="100"></circle>
          <line x1="19" y1="19" x2="81" y2="81" pathLength="100"></line>
        </svg>
      </div>
      <h4>Eğitimde kullanılmaz</h4>
    </div>

    <div class="promise">
      <div class="picto picto--clock" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle class="clock__track" cx="60" cy="60" r="50"></circle>
          {
            hours.map((hour) => (
              <line
                class:list={["clock__tick", { "is-major": hour % 6 === 0 }]}
                x1="60"
                y1="21"
                x2="60"
                y2={hour % 6 === 0 ? 28 : 25}
                transform={`rotate(${hour * 15} 60 60)`}
              />
            ))
          }
          <circle class="clock__arc" cx="60" cy="60" r="50" pathLength="100"></circle>
        </svg>
        <span class="clock__face"><b>24</b><small>saat</small></span>
        <span class="clock__bin"><LuTrash2 /></span>
      </div>
      <h4>En geç 24 saat içinde silinir</h4>
    </div>
  </div>
</Panel>

<style>
  /* Yandaki KVKK kartı daha uzun olduğunda kutucuklar kalan yüksekliği doldurur. */
  .promises {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .promise {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    padding: 30px 20px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.025);
    text-align: center;
  }
  h4 {
    margin: 0;
    font: 650 18px/1.25 var(--font-display);
    letter-spacing: -0.012em;
  }

  .picto {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
  }

  /* Eğitim yok: beyin simgesinin üstünde yasak işareti. */
  .picto--train {
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(245 69 63 / 0.12), transparent);
    color: var(--ink-soft);
  }
  .picto--train > :global(svg:first-child) {
    width: 50px;
    height: 50px;
  }
  .ban {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--c-red);
    stroke-width: 6;
    stroke-linecap: round;
  }
  .ban circle,
  .ban line {
    stroke-dasharray: 100 100;
  }
  .ban circle {
    transform: rotate(-135deg);
    transform-origin: 50% 50%;
  }

  /* 24 saat: kadran saat yönünde boşalır; sonunda çöp kutusu. */
  .picto--clock svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
  }
  .clock__track {
    stroke: rgb(255 255 255 / 0.08);
    stroke-width: 7;
  }
  .clock__tick {
    stroke: rgb(255 255 255 / 0.22);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .clock__tick.is-major {
    stroke: rgb(255 255 255 / 0.45);
    stroke-width: 2;
  }
  .clock__arc {
    stroke: var(--c-yellow);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 100 100;
    stroke-dashoffset: -32;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    filter: drop-shadow(0 0 6px rgb(240 198 58 / 0.45));
  }
  .clock__face {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2px;
  }
  .clock__face b {
    font: 700 30px/1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .clock__face small {
    color: var(--muted);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .clock__bin {
    position: absolute;
    display: grid;
    place-items: center;
    color: var(--c-yellow);
    opacity: 0;
  }
  .clock__bin :global(svg) {
    width: 30px;
    height: 30px;
  }

  /* Görününce yasak işareti çizilir. */
  @media (prefers-reduced-motion: no-preference) {
    .ban circle,
    .ban line {
      stroke-dashoffset: 100;
      transition: stroke-dashoffset 0.8s var(--ease-out) 0.2s;
    }
    .ban line {
      transition-delay: 0.75s;
    }
    .promises:global(.is-in) .ban circle,
    .promises:global(.is-in) .ban line {
      stroke-dashoffset: 0;
    }
  }

  /* Kadran döngüsü (7 sn): dolu başlar, boşalır, çöp kutusu görünür, baştan. */
  .promises:global(.is-live) .clock__arc {
    animation: sec-ai-arc 7s linear infinite both;
  }
  .promises:global(.is-live) .clock__face {
    animation: sec-ai-face 7s ease infinite both;
  }
  .promises:global(.is-live) .clock__bin {
    animation: sec-ai-bin 7s ease infinite both;
  }
  .promises:global(.is-live):not(:global(.is-playing)) * {
    animation-play-state: paused;
  }
  @keyframes sec-ai-arc {
    0% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    6%,
    12% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    77% {
      stroke-dashoffset: -99;
      opacity: 1;
    }
    80%,
    100% {
      stroke-dashoffset: -99;
      opacity: 0;
    }
  }
  @keyframes sec-ai-face {
    0%,
    76% {
      opacity: 1;
      transform: none;
    }
    80%,
    94% {
      opacity: 0;
      transform: scale(0.8);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes sec-ai-bin {
    0%,
    77% {
      opacity: 0;
      transform: scale(0.6);
    }
    82% {
      opacity: 1;
      transform: scale(1.15);
    }
    86%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    97%,
    100% {
      opacity: 0;
      transform: scale(0.8);
    }
  }

  @media (max-width: 560px) {
    .promises {
      grid-template-columns: minmax(0, 1fr);
    }
    .promise {
      grid-template-columns: 84px minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      column-gap: 18px;
      padding: 16px 18px;
      text-align: left;
    }
    .picto {
      width: 84px;
      height: 84px;
    }
    .picto--train > :global(svg:first-child) {
      width: 38px;
      height: 38px;
    }
    .clock__face b {
      font-size: 23px;
    }
    .clock__face small {
      font-size: 8.5px;
    }
  }
</style>

<script>
  import "./play";
</script>
