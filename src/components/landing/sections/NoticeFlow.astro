---
import { LuScale, LuTriangleAlert } from "react-icons/lu";
import SectionHead from "./SectionHead.astro";
import Stage, { type View } from "../screens/Stage.astro";
import { facts } from "../screens/sources";

const TZ = "Europe/Istanbul";
const dayMonth = new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "long", timeZone: TZ });
const weekday = new Intl.DateTimeFormat("tr-TR", { weekday: "long", timeZone: TZ });
const shortDay = new Intl.DateTimeFormat("tr-TR", { weekday: "short", timeZone: TZ });
const dayNum = new Intl.DateTimeFormat("tr-TR", { day: "numeric", timeZone: TZ });

// Tebliğden son güne kadar günler (şerit için).
const DAY = 864e5;
const span = Math.round((facts.deadline.getTime() - facts.served.getTime()) / DAY);
const days = Array.from({ length: span + 1 }, (_, i) => new Date(facts.served.getTime() + i * DAY));
const isWeekend = (d: Date) => ["Cmt", "Paz"].includes(shortDay.format(d));

const steps: (View & { title: string; say: string; text: string })[] = [
  {
    frame: "notice-new",
    focus: "card",
    zoom: 1.35,
    scan: true,
    title: "Tebligat düşer",
    say: "Yeni tebligat geldi!",
    text: "UETS'teki yeni tebligatlar eklentiyle tek tek alınır ve esas numarasından doğru dosyaya bağlanır. Fotoğraf ya da taranmış belge olarak gelse de okunur.",
  },
  {
    frame: "notice-read",
    focus: "card",
    zoom: 1.35,
    title: "Armağan okur",
    say: "Okuyorum…",
    text: "Belgenin türünü ve sonucunu anlar: gerekçeli karar mı, bilirkişi raporu mu, ödeme emri mi; müvekkil lehine mi, aleyhine mi. Her belge türü için ayrı bir okuma akışı çalışır.",
  },
  {
    frame: "record",
    focus: "description",
    zoom: 1.35,
    title: "Kanun hesaplar",
    say: "HMK m.345: iki hafta.",
    text: "Süreyi yapay zekâ tahmin etmez; kanun maddesine bağlı kurallardan hesaplanır. Son gün hafta sonuna ya da resmî tatile denk gelirse bir sonraki iş gününe kayar. Süre kuralları avukatlarca doğrulandı.",
  },
  {
    frame: "calendar",
    focus: "deadline",
    zoom: 1.3,
    title: "Takvime ve göreve işlenir",
    say: "Takvime işledim, görevi açtım.",
    text: "Kesin süre kırmızıyla takvime düşer; aynı iş, dosyanın sorumlularına görev olarak atanır. Kaydın açıklamasında dayanağı ve kanun maddesi yazar.",
  },
  {
    frame: "bell",
    focus: "list",
    zoom: 1.35,
    title: "Ekip haberdar olur",
    say: "Sorumlulara haber verdim.",
    text: "Görev atananlara uygulama içinde bildirim gider. Zil, son tebligat senkronunun özetini ve incelemenizi bekleyenleri gösterir.",
  },
  {
    frame: "review",
    focus: "card",
    zoom: 1.3,
    title: "Emin değilse sorar",
    say: "Bundan emin değilim, bakar mısınız?",
    text: "Tarih okunamadıysa ya da belge türü şüpheliyse süre uydurmaz. Tebligatı “İnceleme gerekli” diye işaretler, nedenini yazar ve kararı size bırakır.",
  },
];

const types = [
  [
    "Gerekçeli Karar",
    "Ara Karar",
    "Tensip Zaptı",
    "Duruşma Tutanağı",
    "Bilirkişi Raporu",
    "Dava Dilekçesi",
    "BAM Kararı",
    "Yargıtay Kararı",
    "İddianame",
    "Kovuşturmaya Yer Olmadığına Dair Karar",
    "Sulh Ceza Kararı",
    "Tebliğname",
  ],
  [
    "Ödeme Emri",
    "Haciz İhbarnamesi",
    "Maaş Haczi",
    "Kıymet Takdiri Raporu",
    "Satış İlanı",
    "İhale Sonucu",
    "Sıra Cetveli",
    "Yürütmeyi Durdurma Kararı",
    "Danıştay Kararı",
    "BİM Kararı",
    "Noter Azilnamesi",
    "Baro Tebligatı",
  ],
];
---

<section
  class="section flow"
  id="tebligat"
  aria-labelledby="flow-title"
  data-companion="red"
  data-companion-say="Yeni tebligat geldi!"
  data-flow
>
  <div class="page-width">
    <SectionHead
      color="red"
      headingId="flow-title"
      eyebrow="Tebligattan süreye"
      title="Yapay zekâ okur, kanun hesaplar."
      lead="Her tebligat iki elden geçer: yapay zekâ belgeyi okuyup türünü ve sonucunu çıkarır; süre ise kanun maddesine bağlı kurallarla hesaplanır. Sonuç takvime, göreve ve bildirime düşer."
    />

    <div class="flow__grid">
      <div class="flow__sticky">
        <Stage
          views={steps}
          accent="var(--c-red)"
          label="ArmağanAI'da bir tebligatın yolculuğu: gelir, okunur, süresi hesaplanır, takvime ve göreve işlenir, ekibe bildirilir."
        />
      </div>

      <ol class="flow__steps">
        {
          steps.map((step, i) => (
            <li class:list={["flow__step", { "is-active": i === 0 }]} data-flow-step={i} data-companion-say={step.say}>
              <span class="flow__n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>

              {i === 1 && (
                <ul class="chips" aria-label="Örnek belge türleri">
                  {["Gerekçeli Karar", "Bilirkişi Raporu", "Ödeme Emri", "Tensip Zaptı", "İddianame", "YD Kararı"].map((t) => (
                    <li>{t}</li>
                  ))}
                  <li class="chips__more">ve dahası</li>
                </ul>
              )}

              {i === 2 && (
                <div class="math">
                  <div class="math__row">
                    <div class="math__day">
                      <small>Tebliğ</small>
                      <b>{dayMonth.format(facts.served)}</b>
                      <span>{weekday.format(facts.served)}</span>
                    </div>
                    <div class="math__rule">
                      <span>+ 2 hafta</span>
                      <code>
                        <LuScale aria-hidden="true" /> HMK m.345
                      </code>
                    </div>
                    <div class="math__day math__day--due">
                      <small>Son gün</small>
                      <b>{dayMonth.format(facts.deadline)}</b>
                      <span>{weekday.format(facts.deadline)}</span>
                    </div>
                  </div>
                  <ol class="strip" aria-hidden="true">
                    {days.map((d, k) => (
                      <li
                        class:list={{
                          "is-weekend": isWeekend(d),
                          "is-start": k === 0,
                          "is-due": k === days.length - 1,
                        }}
                      >
                        {dayNum.format(d)}
                      </li>
                    ))}
                  </ol>
                </div>
              )}


              {i === 5 && (
                <blockquote class="review">
                  <LuTriangleAlert aria-hidden="true" />
                  <p>“Bu bir kıymet takdiri raporu olabilir; itiraz süresi İİK m.128/a uyarınca 7 gün olabilir.”</p>
                </blockquote>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="types" aria-label="Armağan'ın tanıdığı tebligat türlerinden bazıları">
      {
        types.map((row, r) => (
          <div class:list={["types__row", { "types__row--reverse": r === 1 }]}>
            {[0, 1].map((copy) => (
              <ul class="types__track" aria-hidden={copy === 1 ? "true" : undefined}>
                {row.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            ))}
          </div>
        ))
      }
    </div>

  </div>
</section>

<style>
  .section {
    padding: clamp(88px, 11vw, 150px) 0;
  }
  .flow__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    grid-template-areas: "steps stage";
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .flow__sticky {
    grid-area: stage;
    position: sticky;
    top: max(96px, calc(50vh - 17vw));
  }
  .flow__steps {
    grid-area: steps;
    padding: 6vh 0 22vh;
  }
  .flow__step {
    display: grid;
    align-content: center;
    gap: 14px;
    min-height: 68vh;
    opacity: 0.3;
    transition: opacity 0.5s ease;
  }
  .flow__step.is-active {
    opacity: 1;
  }
  .flow__n {
    color: var(--c-red-ink);
    font: 600 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  h3 {
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .flow__step > p {
    color: var(--ink-soft);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 13.5px;
    font-weight: 500;
  }
  .chips__more {
    border-style: dashed !important;
    background: transparent !important;
  }

  /* Süre hesabı: tebliğ → son gün, arada günler. */
  .math {
    display: grid;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .math__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
  }
  .math__day {
    display: grid;
    gap: 3px;
  }
  .math__day small {
    color: var(--muted);
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .math__day b {
    font: 650 18px/1.1 var(--font-display);
  }
  .math__day span {
    color: var(--ink-soft);
    font-size: 13px;
  }
  .math__day--due {
    text-align: right;
  }
  .math__day--due b {
    color: var(--danger-ink);
  }
  .math__rule {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    color: var(--ink-soft);
    font-size: 13px;
    font-weight: 600;
  }
  .math__rule::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 4px;
    right: 4px;
    z-index: 0;
    border-top: 1.5px dashed var(--line-strong);
  }
  .math__rule span,
  .math__rule code {
    position: relative;
    z-index: 1;
    padding: 2px 8px;
    background: var(--surface);
  }
  .math__rule code {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid color-mix(in srgb, var(--c-red) 35%, transparent);
    border-radius: 6px;
    color: var(--danger-ink);
    font: 600 12px/1.5 var(--font-mono);
  }
  .math__rule :global(svg) {
    width: 13px;
    height: 13px;
  }
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 3px;
  }
  .strip li {
    display: grid;
    place-items: center;
    height: 26px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink-soft);
    font: 600 10.5px/1 var(--font-mono);
  }
  .strip li.is-weekend {
    background: transparent;
    color: var(--muted);
    opacity: 0.6;
  }
  .strip li.is-start {
    background: var(--ink);
    color: var(--bg);
  }
  .strip li.is-due {
    background: var(--cal-deadline);
    color: #fff;
  }

  .review {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--warn-line);
    border-radius: var(--radius);
    background: var(--warn-bg);
    color: var(--warn-ink);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
  }
  .review :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  /* Tanıdığı tebligat türleri: iki sıra, ters yönlere akar. */
  .types {
    display: grid;
    gap: 12px;
    margin-top: clamp(40px, 6vw, 80px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .types__row {
    display: flex;
    overflow: hidden;
  }
  .types__track {
    display: flex;
    flex: none;
    gap: 10px;
    padding-right: 10px;
    animation: marquee 48s linear infinite;
  }
  .types__row--reverse .types__track {
    animation-direction: reverse;
  }
  .types:hover .types__track,
  .types:global(.is-off) .types__track {
    animation-play-state: paused;
  }
  .types__track li {
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
  }
  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 960px) {
    .flow__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "stage" "steps";
      gap: 0;
    }
    .flow__sticky {
      top: 76px;
      z-index: 2;
      padding: 8px 0 16px;
      background: linear-gradient(180deg, var(--bg) 88%, transparent);
    }
    .flow__steps {
      padding: 2vh 0 10vh;
    }
    .flow__step {
      min-height: 52vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .types__track {
      animation: none;
      flex-wrap: wrap;
    }
    .types__row {
      overflow: visible;
    }
    .types__track[aria-hidden] {
      display: none;
    }
    .flow__step {
      transition: none;
    }
  }
</style>

<script>
  import { runNoticeFlow } from "./notice-flow";
  document.querySelectorAll<HTMLElement>("[data-flow]").forEach(runNoticeFlow);
</script>
