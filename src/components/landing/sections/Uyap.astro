---
import {
  LuFolderOpen,
  LuUsers,
  LuFolderTree,
  LuHistory,
  LuStar,
  LuSearch,
  LuFileText,
  LuFolderDown,
  LuLock,
  LuArrowRight,
} from "react-icons/lu";
import SectionHead from "./SectionHead.astro";
import FeatureTour, { type TourTab } from "../screens/FeatureTour.astro";
import AppShot from "../screens/AppShot.astro";

// Üstteki sahne: UYAP'tan gelen dosya, taraf ve evrak. Metinler app'in gerçek davranışına göre.
const tabs: TourTab[] = [
  {
    id: "dosyalar",
    icon: LuFolderOpen,
    title: "Tüm dosyalarınız",
    text: "Hukuk, ceza ve idari dosyalar tek listede, icra takipleri ayrı. Kartta mahkeme, esas no, rolünüz, sonraki duruşma ve dosyanın UYAP'taki durumu.",
    screen: "Dosyalar listesi: mahkeme, esas numarası, taraf rolü, sonraki duruşma ve UYAP durumu gösteren kartlar.",
    frame: "cases",
    focus: "grid",
    zoom: 1.2,
  },
  {
    id: "taraflar",
    icon: LuUsers,
    title: "Taraflar ve vekiller",
    text: "Davacı, davalı, ihbar olunan; vekilleri ve tanıklarıyla. Müvekkil ve karşı taraf kartları UYAP'tan oluşur; emin olamadığı eşleşmeyi size sorar.",
    screen: "Dosya kartı: müvekkil, diğer taraflar ve davalı tarafı kutuları; vekiller ve tanıklar.",
    frame: "case",
    focus: "parties",
    zoom: 1.2,
  },
  {
    id: "klasorler",
    icon: LuFolderTree,
    title: "Klasörler ve ekler",
    text: "Evrak, UYAP'taki dosyasına ve türüne göre gruplanır; dilekçenin ekleri altında durur. Değişik iş gibi bağlı dosyalar ayrı klasörde.",
    screen: "Tüm Evraklar: dava dilekçesi ve üç eki açık; duruşma zaptı, makbuz, tebligat mazbatası grupları ve değişik iş klasörü.",
    frame: "docs",
    focus: "attachments",
    zoom: 1.3,
  },
  {
    id: "tarih",
    icon: LuHistory,
    title: "En yeni evrak en üstte",
    text: "Tarih görünümünde her evrakın kimden geldiği yanında yazar: mahkeme, karşı taraf, bilirkişi. Henüz inmemiş evrakı tek tıkla UYAP'tan indirin.",
    screen: "Tarihe göre evrak listesi: gerekçeli karar, duruşma zabıtları, bilirkişi raporları; kaynağına göre rozetler.",
    frame: "docs-date",
    focus: "latest",
    zoom: 1.2,
  },
];

// Alttaki kartlar: gerçek ekranlardan kırpılmış bölümler.
const cards = [
  {
    icon: LuStar,
    title: "Önce önemli olan",
    text: "Dilekçeler, zabıtlar, bilirkişi raporları ve kararlar Öncelikli Evraklar'da toplanır; mazbata ve makbuz arasında kaybolmaz. İsterseniz yalnız bunları indirin.",
    shot: "priority--head",
    alt: "Öncelikli Evraklar: toplam 22 öncelikli evrak, ekler dahil; bilirkişi raporu açık.",
  },
  {
    icon: LuSearch,
    title: "Eklerine kadar arayın",
    text: "Evrakın adında, açıklamasında ve eklerin adlarında arar; neden eşleştiğini yanında yazar.",
    shot: "search--results",
    alt: "Evrak araması: “sözleşme” için 3 evrak bulundu; açıklamasında ve ekinde geçiyor etiketleri.",
  },
  {
    icon: LuFileText,
    title: "UDF'yi tarayıcıda açın",
    text: "UYAP Doküman Editörü gerekmeden UDF, PDF, TIFF ve Word evrakı yan panelde açılır; tek tıkla PDF olarak indirin.",
    shot: "preview--page",
    alt: "Gerekçeli karar UDF dosyası tarayıcıdaki önizlemede, A4 sayfa olarak açık.",
  },
  {
    icon: LuFolderDown,
    title: "Bilgisayarınıza aktarın",
    text: "Dosyadaki evrakı PDF'e çevirip seçtiğiniz klasöre indirin; aynı klasöre yeniden aktardığınızda yalnız yeni evrak iner.",
    shot: "export--dialog",
    alt: "Toplu Dışa Aktarma penceresi: evraklar PDF olarak ya da olduğu gibi indirilebilir.",
  },
];
---

<section
  class="section"
  id="uyap"
  aria-labelledby="uyap-title"
  data-companion="purple"
  data-companion-say="Evrak düzeni bende."
>
  <div class="page-width">
    <SectionHead
      color="purple"
      headingId="uyap-title"
      eyebrow="UYAP ve evrak"
      title="UYAP'taki dosyalarınız, tek yerde ve düzenli."
      lead="Eklenti dosyalarınızı, taraflarını, duruşmalarını ve evrakını UYAP'tan alır. Evrak klasörüne ve türüne ayrılır, önemli olan öne çıkar; UDF bile tarayıcıda açılır."
    />

    <FeatureTour
      id="uyap"
      tabs={tabs}
      color="purple"
      listLabel="UYAP'tan gelenler"
      label="ArmağanAI'da UYAP'tan gelen dosyalar, taraflar ve evraklar."
    />

    <ul class="cards">
      {
        cards.map(({ icon: Icon, title, text, shot, alt }, i) => (
          <li class="card" data-reveal style={`--i:${i % 2}`}>
            <div class="card__text">
              <h3>
                <Icon aria-hidden="true" />
                {title}
              </h3>
              <p>{text}</p>
            </div>
            <div class="card__shot">
              <AppShot shot={shot} alt={alt} sizes="(min-width: 1000px) 560px, 92vw" />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="foot">
      <p class="foot__stat"><b>1 milyon+</b><span>evrak UYAP'tan alınıp klasörlendi</span></p>
      <p class="foot__lock">
        <LuLock aria-hidden="true" />
        <span>İndirilen evrak, büro anahtarınızla şifrelenerek saklanır.</span>
        <a href="#guvenlik">Nasıl korunduğunu görün <LuArrowRight aria-hidden="true" /></a>
      </p>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(88px, 11vw, 150px) 0;
  }

  /* Alttaki kartlar */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(48px, 7vw, 88px);
  }
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--glass);
  }
  .card__text {
    padding: 26px 28px 20px;
  }
  .card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font: 650 19px/1.25 var(--font-display);
    letter-spacing: -0.01em;
  }
  .card h3 :global(svg) {
    flex: none;
    width: 19px;
    height: 19px;
    color: var(--c-purple-ink);
  }
  .card p {
    max-width: 520px;
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.55;
  }
  /* Ekran parçası kartın sağ alt köşesinden taşar; üst kısmı (asıl içerik) görünür. */
  .card__shot {
    align-self: end;
    height: clamp(230px, 28vw, 400px);
    overflow: hidden;
    padding-left: 28px;
  }
  .card__shot :global(.shot) {
    height: 100%;
    border-right: 0;
    border-bottom: 0;
    border-radius: 14px 0 0 0;
  }
  .card__shot :global(.shot__img) {
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 40px;
    margin-top: clamp(32px, 4.5vw, 52px);
    color: var(--ink-soft);
    font-size: 15px;
  }
  .foot__stat {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .foot__stat b {
    color: var(--ink);
    font: 650 clamp(26px, 3vw, 34px)/1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .foot__lock {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
  }
  .foot :global(svg) {
    width: 17px;
    height: 17px;
    color: var(--c-purple-ink);
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-purple) 55%, transparent);
    text-underline-offset: 3px;
  }
  .foot a :global(svg) {
    color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.7s var(--ease-out),
        transform 0.7s var(--ease-out);
    }
    .card {
      transition-delay: calc(var(--i) * 120ms);
    }
    .card:global(.is-in) {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .card__text {
      padding: 22px 20px 16px;
    }
    .card__shot {
      height: 220px;
      padding-left: 20px;
    }
  }
</style>

