---
import { LuGavel, LuSmartphone, LuCamera, LuMessagesSquare, LuGlobe } from "react-icons/lu";
import SectionHead from "./SectionHead.astro";
import AppShot from "../screens/AppShot.astro";

// Telefon ve tablet: gerçek ekranlar dokunmatik cihaz boyutunda çekildi (npm run screens: t-priority, m-agenda).
// App yüklenebilir bir uygulama değil; tarayıcıdan açılır, istenirse ana ekrana kısayol eklenir.
const points = [
  {
    icon: LuGavel,
    title: "Duruşmada dijital",
    text: "Kalın dosya taşımayın: tabletinizde dosyanın öncelikli evrakı, tarafları ve duruşma bilgisi bir dokunuşta.",
  },
  {
    icon: LuSmartphone,
    title: "Büro cebinizde",
    text: "Dışarıdayken de dosyalarınıza bakın, günün programını görün, görev açın.",
  },
  {
    icon: LuCamera,
    title: "Tebligatı telefondan ekleyin",
    text: "Mesai dışında elden ya da KEP'le gelen tebligatı telefondan ekleyin; fotoğrafı bile yeter. Armağan okusun, takvime yazsın.",
  },
  {
    icon: LuMessagesSquare,
    title: "Asistan da yanınızda",
    text: "Telefondan yazın; görevi ve takvim kaydını Armağan açsın.",
  },
  {
    icon: LuGlobe,
    title: "Kurulum yok",
    text: "Telefonun ya da tabletin tarayıcısından girin; isterseniz ana ekrana ekleyin.",
  },
];
---

<section class="section" id="her-yerde" aria-labelledby="her-yerde-title" data-companion="green" data-companion-say="Cebinizdeyim.">
  <div class="page-width">
    <SectionHead
      color="green"
      headingId="her-yerde-title"
      eyebrow="Telefon ve tablet"
      title="Duruşmaya dosya taşımayın."
      lead="Armağan bilgisayarda, telefonda ve tablette aynı. Duruşmada evraka, yolda takvime ve görevlere, akşam gelen tebligata bir dokunuşla ulaşın."
    />

    <div class="split" data-reveal>
      <div class="devices">
        <figure class="device device--tablet">
          <AppShot
            shot="t-priority"
            sizes="(min-width: 1000px) 480px, 76vw"
            alt="Tablette ArmağanAI: 2025/318 dosyasının öncelikli evrakları; bilirkişi raporu açık."
          />
        </figure>
        <figure class="device device--phone">
          <AppShot
            shot="m-agenda"
            sizes="(min-width: 1000px) 210px, 44vw"
            alt="Telefonda ArmağanAI Günün Programı: takip işi, duruşma, toplantı ve randevu."
          />
        </figure>
      </div>

      <ul class="points">
        {
          points.map(({ icon: Icon, title, text }, i) => (
            <li style={`--i:${i}`}>
              <Icon className="points__icon" aria-hidden="true" />
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(88px, 11vw, 150px) 0;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  /* Cihaz çerçeveleri: yalnızca kasa; içindeki ekran gerçek app görüntüsü. */
  .devices {
    position: relative;
    padding: 0 0 clamp(24px, 4vw, 48px) clamp(40px, 7vw, 96px);
  }
  .devices::before {
    content: "";
    position: absolute;
    inset: 4% 0 8% 10%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c-green) 20%, transparent), transparent);
    filter: blur(12px);
  }
  .device {
    margin: 0;
    background: #0d0f0e;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      0 40px 80px -36px rgb(17 22 20 / 0.6),
      0 18px 36px -24px rgb(17 22 20 / 0.4);
  }
  .device :global(.shot) {
    border: 0;
    box-shadow: none;
    background: #0d0f0e;
  }
  .device--tablet {
    width: min(100%, 480px);
    margin-left: auto;
    padding: 12px;
    border-radius: 34px;
  }
  .device--tablet :global(.shot) {
    border-radius: 23px;
  }
  .device--phone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(132px, 17vw, 210px);
    padding: 7px;
    border-radius: 34px;
  }
  .device--phone :global(.shot) {
    border-radius: 28px;
  }

  .points {
    display: grid;
    gap: 20px;
  }
  .points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
  }
  .points :global(.points__icon) {
    width: 40px;
    height: 40px;
    padding: 10px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c-green) 16%, transparent);
    color: var(--c-green-ink);
  }
  .points h3 {
    margin-bottom: 4px;
    font: 650 18.5px/1.25 var(--font-display);
    letter-spacing: -0.01em;
  }
  .points p {
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    .device--tablet,
    .device--phone,
    .points li {
      opacity: 0;
      transition:
        opacity 0.7s var(--ease-out),
        transform 0.8s var(--ease-out);
    }
    .device--tablet {
      transform: translateY(18px);
    }
    .device--phone {
      transform: translate(-12px, 24px) rotate(-3deg);
      transition-delay: 0.15s;
    }
    .points li {
      transform: translateY(12px);
      transition-delay: calc(0.2s + var(--i) * 90ms);
    }
    .split:global(.is-in) .device--tablet,
    .split:global(.is-in) .points li {
      opacity: 1;
      transform: none;
    }
    .split:global(.is-in) .device--phone {
      opacity: 1;
      transform: rotate(-3deg);
    }
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .devices {
      max-width: 560px;
      margin: 0 auto;
    }
  }
</style>
