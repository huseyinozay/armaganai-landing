---
// Kaydırınca eşlik eden Armağan: hero'dan sonra sağ altta belirir, her bölümde o bölümün
// rengindeki Armağan'a dönüşür ve kısa konuşma balonlarıyla anlatır.
// Bölümler `data-companion="renk"`, adımlar `data-companion-say="…"` ile yönlendirir.
import Armagan from "../mascot/Armagan.astro";
import { MASCOT_COLORS } from "../mascot/family";
---

<div class="companion" data-companion-root aria-hidden="true">
  <p class="say" data-say></p>
  <div class="body" data-companion-body>
    {MASCOT_COLORS.map((color) => <Armagan color={color} class="member" />)}
  </div>
</div>

<style>
  .companion {
    --size: 84px;
    position: fixed;
    right: clamp(12px, 2.2vw, 32px);
    bottom: clamp(12px, 3vh, 28px);
    z-index: 45;
    width: var(--size);
    pointer-events: none;
    opacity: 0;
    transform: translateY(140%);
    transition:
      transform 0.7s var(--ease-spring),
      opacity 0.4s ease;
  }
  .companion:global(.is-on) {
    opacity: 1;
    transform: none;
  }
  .body {
    position: relative;
    aspect-ratio: 1268 / 1336;
    transform-origin: 50% 100%;
  }
  .body > :global(.member) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(26%) scale(0.72);
    transition:
      opacity 0.35s ease,
      transform 0.55s var(--ease-spring);
  }
  .body > :global(.member.is-active) {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .say {
    position: absolute;
    right: calc(100% - 6px);
    bottom: 62%;
    width: max-content;
    max-width: min(260px, 60vw);
    padding: 10px 14px;
    border: 1px solid var(--glass-line);
    border-radius: 16px 16px 4px 16px;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    box-shadow: 0 18px 40px -20px rgb(17 22 20 / 0.5);
    color: var(--ink);
    font: 500 14px/1.4 var(--font-text);
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transform-origin: 100% 100%;
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease-out);
  }
  .say:global(.is-on) {
    opacity: 1;
    transform: none;
  }

  /* Dar ekranda balon metnin üstüne binmesin: Armağan yalnız renk değiştirip tepki verir. */
  @media (max-width: 640px) {
    .companion {
      --size: 58px;
    }
    .say {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .companion,
    .body > :global(.member),
    .say {
      transition: none;
    }
  }
</style>

<script>
  import { runCompanion } from "./companion";
  document.querySelectorAll<HTMLElement>("[data-companion-root]").forEach(runCompanion);
</script>
